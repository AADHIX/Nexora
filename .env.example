# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local: mongodb://127.0.0.1:27017/nexora
# For production: mongodb+srv://<username>:<password>@cluster.mongodb.net/nexora
MONGODB_URI=mongodb://127.0.0.1:27017/nexora

# JWT Security
JWT_SECRET=super_secret_key_change_me_in_production
JWT_EXPIRE=7d

# Initial Admin Seeding Account
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=NexoraSecure2026!

# Email Service SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Nexora Health <noreply@nexorahealth.com>

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
